function cmdConfig(opts, loadedFiles) {
  const files = CONFIG_FILES.map((f) => ({ path: f, exists: fs.existsSync(f), loaded: loadedFiles.includes(f) }));
  emit(
    {
      url: opts.url,
      timeout: opts.timeout,
      logLevel: opts.level,
      json: opts.json,
      color: opts.color,
      files,
      cli: CLI_VERSION,
      node: process.versions.node,
      platform: `${os.platform()} ${os.release()}`,
    },
    [
      `URL:       ${opts.url}`,
      `Timeout:   ${opts.timeout} ms`,
      `Log level: ${opts.level}`,
      `Platform:  ${os.platform()} ${os.release()} · node ${process.versions.node}`,
      "ملفات الإعداد:",
      ...files.map((f) => `  ${f.exists ? (f.loaded ? "✔ مُحمّل" : "• موجود") : "✖ مفقود"}  ${f.path}`),
    ],
    opts,
  );
  return EXIT.OK;
}

function openBrowser(url) {
  const openers = ["xdg-open", "gio", "sensible-browser", "x-www-browser", "open"];
  for (const bin of openers) {
    try {
      execFileSync("which", [bin], { stdio: "ignore" });
      const args = bin === "gio" ? ["open", url] : [url];
      spawn(bin, args, { detached: true, stdio: "ignore" }).unref();
      return bin;
    } catch {
      /* try next opener */
    }
  }
  return null;
}

function cmdOpen(opts, rest) {
  const target = rest[0] ? (rest[0].startsWith("http") ? rest[0] : `${opts.url}${rest[0].startsWith("/") ? "" : "/"}${rest[0]}`) : opts.url;
  const opener = openBrowser(target);
  if (!opener) {
    log.error("open", "لم يُعثر على متصفح (xdg-open غير متوفّر).");
    emit({ opened: false, url: target }, [`تعذّر فتح المتصفح — افتح يدوياً: ${target}`], opts);
    return EXIT.INTERNAL;
  }
  emit({ opened: true, url: target, opener }, [`فُتح: ${target}`], opts);
  return EXIT.OK;
}

async function cmdWatch(opts, rest) {
  let every = 30;
  const idx = rest.indexOf("--every");
  if (idx !== -1 && rest[idx + 1]) every = Math.max(5, Number(rest[idx + 1]) || 30);
  out(`مراقبة ${opts.url} كل ${every}s — Ctrl+C للإيقاف`);
  for (;;) {
    const stamp = new Date().toLocaleTimeString();
    try {
      const { data, ms } = await api(opts);
      out(`${stamp}  ${data.healthy ? "OK  " : "FAIL"}  ${ms}ms  web=${data.services?.web ? 1 : 0} backend=${data.services?.backend ? 1 : 0}`);
    } catch (e) {
      out(`${stamp}  DOWN  ${e.message}`);
    }
    await new Promise((r) => setTimeout(r, every * 1000));
  }
}

/* -------------------------------------------------------- demo accounts */

async function postJson(opts, pathname, payload) {
  const target = `${opts.url}${pathname}`;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), opts.timeout);
  log.debug("http", `POST ${target}`);
  try {
    const res = await fetch(target, {
      method: "POST",
      headers: {
        "content-type": "application/json",
        accept: "application/json",
        "user-agent": `idaroom-cli/${CLI_VERSION}`,
      },
      body: JSON.stringify(payload),
      signal: controller.signal,
    });
    let data = null;
    try {
      data = await res.json();
    } catch {
      const err = new Error("الرد ليس بصيغة JSON صالحة");
      err.code = EXIT.PROTOCOL;
      throw err;
    }
    log.debug("http", `${res.status}`);
    return { status: res.status, data };
  } catch (e) {
    if (e.code) throw e;
    const err = new Error(e.name === "AbortError" ? `انتهت المهلة بعد ${opts.timeout}ms` : e.message);
    err.code = EXIT.NETWORK;
    throw err;
  } finally {
    clearTimeout(timer);
  }
}

function askHidden(question) {
  return new Promise((resolve) => {
    if (!process.stdin.isTTY) return resolve("");
    const readline = require("readline");
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout, terminal: true });
    const onData = (char) => {
      if (["\n", "\r", "\u0004"].includes(String(char))) process.stdin.removeListener("data", onData);
      else process.stdout.write("\x1b[2K\x1b[200D" + question + "*".repeat(rl.line.length));
    };
    process.stdin.on("data", onData);
    rl.question(question, (answer) => {
      rl.close();
      process.stdout.write("\n");
      resolve(answer);
    });
  });
}

const DEMO_HELP = `idaroom demo — إدارة الحسابات التجريبية (يتطلب صلاحية admin)

  idaroom demo list
  idaroom demo create <email|prefix> --role <role> [--name "الاسم"] [--password <pw>]
  idaroom demo disable <email|prefix>
  idaroom demo enable  <email|prefix>
  idaroom demo password <email|prefix> --password <new>
  idaroom demo link <email|prefix> [--class "أولى ثانوي - علوم"] [--card 04A1B2C3]

  الأدوار: admin | director | supervisor | teacher | parent | student | gate_monitor
  الاعتماد: --admin-email / --admin-password أو IDAROOM_ADMIN_EMAIL / IDAROOM_ADMIN_PASSWORD
  ملاحظة: العمليات مقيّدة بنطاق البريد demo.idarroom.dz فقط.`;

async function cmdDemo(opts, rest) {
  const sub = (rest.shift() || "").toLowerCase();
  const actions = ["list", "create", "disable", "enable", "password", "link"];
  if (!sub || sub === "help" || !actions.includes(sub)) {
    out(DEMO_HELP);
    return sub && sub !== "help" ? EXIT.USAGE : EXIT.OK;
  }

  let adminEmail = opts.adminEmail;
  let adminPassword = opts.adminPassword;
  if (!adminEmail) {
    log.error("demo", "بريد المسؤول مفقود (--admin-email أو IDAROOM_ADMIN_EMAIL)");
    out("مطلوب: --admin-email <email>");
    return EXIT.USAGE;
  }
  if (!adminPassword) adminPassword = await askHidden("كلمة مرور المسؤول: ");
  if (!adminPassword) {
    out("مطلوب: --admin-password <pw> أو IDAROOM_ADMIN_PASSWORD");
    return EXIT.USAGE;
  }

  const target = rest[0] || "";
  if (sub !== "list" && !target) {
    out(`مطلوب تحديد الحساب: idaroom demo ${sub} <email|prefix>`);
    return EXIT.USAGE;
  }
  if (sub === "create" && !opts.role) {
    out("مطلوب: --role <admin|director|supervisor|teacher|parent|student|gate_monitor>");
    return EXIT.USAGE;
  }
  if (sub === "password" && !opts.newPassword) {
    out("مطلوب: --password <كلمة المرور الجديدة>");
    return EXIT.USAGE;
  }
  if (sub === "link" && !opts.className && !opts.cardUid) {
    out("مطلوب: --class و/أو --card");
    return EXIT.USAGE;
  }

  const payload = {
    email: adminEmail,
    password: adminPassword,
    action: sub,
    ...(target ? { target } : {}),
    ...(opts.role ? { role: opts.role } : {}),
    ...(opts.name ? { name: opts.name } : {}),
    ...(opts.newPassword ? { newPassword: opts.newPassword } : {}),
    ...(opts.className ? { className: opts.className } : {}),
    ...(opts.cardUid ? { cardUid: opts.cardUid } : {}),
  };

  const { status, data } = await postJson(opts, "/api/public/cli-demo", payload);
  if (!data || data.ok !== true) {
    const msg = (data && (data.error || data.hint)) || `HTTP ${status}`;
    log.error("demo", msg);
    emit({ ok: false, status, error: msg, details: data?.details ?? null }, [`فشل: ${msg}`], opts);
    if (status === 401 || status === 403) return EXIT.USAGE;
    if (status === 404) return EXIT.UNHEALTHY;
    return status >= 500 ? EXIT.INTERNAL : EXIT.USAGE;
  }

  if (sub === "list") {
    const lines = [`الحسابات التجريبية: ${data.count}`];
    for (const a of data.accounts) {
      const st = a.student ? `  قسم=${a.student.className || "—"} بطاقة=${a.student.cardUid || "—"}` : "";
      lines.push(
        `  ${a.disabled ? "✖" : "✔"} ${String(a.email).padEnd(34)} [${a.role || "بلا دور"}]${st}`,
      );
    }
    emit(data, lines, opts);
    return EXIT.OK;
  }

  const summary = {
    create: () => `أُنشئ/حُدّث ${data.email} [${data.role}] — كلمة المرور: ${data.password}`,
    disable: () => `عُطّل ${data.email}`,
    enable: () => `فُعّل ${data.email}`,
    password: () => `تم تغيير كلمة مرور ${data.email}`,
    link: () => `رُبط ${data.email} — قسم=${data.className || "—"} بطاقة=${data.cardUid || "—"}`,
  }[sub]();
  emit(data, [summary], opts);
  return EXIT.OK;
}

