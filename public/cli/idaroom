#!/usr/bin/env node
/**
 * IDAROOM — standalone Linux command line tool.
 *
 * Pure Node.js (>= 18), zero dependencies, no Electron and no desktop
 * environment required. Works over SSH, in scripts, cron jobs and CI.
 *
 *   idaroom help
 *   idaroom status --json
 *   idaroom health && echo "OK"
 *   idaroom doctor
 *   idaroom open /dashboard/students
 */

"use strict";

const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawn, execFileSync } = require("child_process");

const CLI_VERSION = "1.3.0";
const DEFAULT_URL = "https://idarroom.lovable.app";

const EXIT = {
  OK: 0,
  UNHEALTHY: 1,
  NETWORK: 2,
  USAGE: 3,
  PROTOCOL: 4,
  INTERNAL: 5,
  NEEDROOT: 6,
  FIXFAILED: 7,
};

/* ------------------------------------------------------------------ config */

const CONFIG_FILES = [
  "/etc/idaroom/idaroom.env",
  path.join(os.homedir(), ".config", "idaroom", "idaroom.env"),
  process.env.IDAROOM_CONFIG || "",
].filter(Boolean);

function loadEnvFiles() {
  const loaded = [];
  for (const file of CONFIG_FILES) {
    try {
      if (!fs.existsSync(file)) continue;
      const text = fs.readFileSync(file, "utf8");
      for (const rawLine of text.split(/\r?\n/)) {
        const line = rawLine.trim();
        if (!line || line.startsWith("#")) continue;
        const eq = line.indexOf("=");
        if (eq === -1) continue;
        const key = line.slice(0, eq).trim();
        let value = line.slice(eq + 1).trim();
        if (
          (value.startsWith('"') && value.endsWith('"')) ||
          (value.startsWith("'") && value.endsWith("'"))
        ) {
          value = value.slice(1, -1);
        }
        if (key && process.env[key] === undefined) process.env[key] = value;
      }
      loaded.push(file);
    } catch {
      /* unreadable config files are reported by `doctor` */
    }
  }
  return loaded;
}

/* ------------------------------------------------------------------ logger */

const LEVELS = { silent: 0, error: 1, warn: 2, info: 3, debug: 4, trace: 5 };

const log = {
  level: "warn",
  json: false,
  color: true,
  write(level, tag, message, extra) {
    if (LEVELS[level] > LEVELS[this.level]) return;
    if (this.json) {
      process.stderr.write(
        JSON.stringify({ ts: new Date().toISOString(), level, tag, message, ...(extra || {}) }) + "\n",
      );
      return;
    }
    const colors = { error: "\x1b[31m", warn: "\x1b[33m", info: "\x1b[36m", debug: "\x1b[90m", trace: "\x1b[90m" };
    const c = this.color ? colors[level] || "" : "";
    const r = this.color ? "\x1b[0m" : "";
    process.stderr.write(`${c}[${level}]${r} ${tag ? tag + ": " : ""}${message}\n`);
  },
  error: (t, m, e) => log.write("error", t, m, e),
  warn: (t, m, e) => log.write("warn", t, m, e),
  info: (t, m, e) => log.write("info", t, m, e),
  debug: (t, m, e) => log.write("debug", t, m, e),
  trace: (t, m, e) => log.write("trace", t, m, e),
};

function out(line) {
  process.stdout.write(String(line) + "\n");
}
function emit(obj, textLines, opts) {
  if (opts.json) out(JSON.stringify(obj, null, opts.pretty ? 2 : 0));
  else textLines.forEach(out);
}

/* -------------------------------------------------------------------- args */

function parseArgs(argv) {
  const opts = {
    json: !!process.env.IDAROOM_JSON,
    pretty: true,
    url: process.env.IDAROOM_URL || DEFAULT_URL,
    timeout: Number(process.env.IDAROOM_TIMEOUT || 10000),
    fix: !!process.env.IDAROOM_FIX,
    dryRun: false,
    color: !process.env.IDAROOM_NO_COLOR && process.stderr.isTTY !== false,
    level: process.env.IDAROOM_LOG_LEVEL || (process.env.IDAROOM_VERBOSE ? "debug" : "warn"),
    adminEmail: process.env.IDAROOM_ADMIN_EMAIL || "",
    adminPassword: process.env.IDAROOM_ADMIN_PASSWORD || "",
    role: "",
    name: "",
    className: "",
    cardUid: "",
    newPassword: "",
  };
  const rest = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--json") opts.json = true;
    else if (a === "--no-pretty") opts.pretty = false;
    else if (a === "--no-color") opts.color = false;
    else if (a === "--fix") opts.fix = true;
    else if (a === "-n" || a === "--dry-run") opts.dryRun = true;
    else if (a === "-q" || a === "--quiet") opts.level = "error";
    else if (a === "-V" || a === "--verbose") opts.level = "debug";
    else if (a === "-vv") opts.level = "trace";
    else if (a === "--log-level") opts.level = argv[++i];
    else if (a.startsWith("--log-level=")) opts.level = a.split("=")[1];
    else if (a === "--url") opts.url = argv[++i];
    else if (a.startsWith("--url=")) opts.url = a.split("=").slice(1).join("=");
    else if (a === "--timeout") opts.timeout = Number(argv[++i]);
    else if (a.startsWith("--timeout=")) opts.timeout = Number(a.split("=")[1]);
    else if (a === "--role") opts.role = argv[++i];
    else if (a.startsWith("--role=")) opts.role = a.split("=")[1];
    else if (a === "--name") opts.name = argv[++i];
    else if (a.startsWith("--name=")) opts.name = a.split("=").slice(1).join("=");
    else if (a === "--class") opts.className = argv[++i];
    else if (a.startsWith("--class=")) opts.className = a.split("=").slice(1).join("=");
    else if (a === "--card") opts.cardUid = argv[++i];
    else if (a.startsWith("--card=")) opts.cardUid = a.split("=")[1];
    else if (a === "--password") opts.newPassword = argv[++i];
    else if (a.startsWith("--password=")) opts.newPassword = a.split("=").slice(1).join("=");
    else if (a === "--admin-email") opts.adminEmail = argv[++i];
    else if (a.startsWith("--admin-email=")) opts.adminEmail = a.split("=")[1];
    else if (a === "--admin-password") opts.adminPassword = argv[++i];
    else if (a.startsWith("--admin-password=")) opts.adminPassword = a.split("=").slice(1).join("=");
    else rest.push(a);
  }
  opts.url = String(opts.url || DEFAULT_URL).replace(/\/+$/, "");
  if (!LEVELS[opts.level]) opts.level = "warn";
  if (!Number.isFinite(opts.timeout) || opts.timeout <= 0) opts.timeout = 10000;
  log.level = opts.level;
  log.json = opts.json;
  log.color = opts.color;
  return { opts, rest };
}

/* -------------------------------------------------------------------- http */

async function api(opts, pathname = "/api/public/cli") {
  const target = `${opts.url}${pathname}`;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), opts.timeout);
  const started = Date.now();
  log.debug("http", `GET ${target} (timeout ${opts.timeout}ms)`);
  try {
    const res = await fetch(target, {
      headers: { accept: "application/json", "user-agent": `idaroom-cli/${CLI_VERSION}` },
      signal: controller.signal,
    });
    const ms = Date.now() - started;
    log.debug("http", `${res.status} in ${ms}ms`);
    if (!res.ok) {
      const err = new Error(`HTTP ${res.status}`);
      err.code = EXIT.PROTOCOL;
      throw err;
    }
    let data;
    try {
      data = await res.json();
    } catch {
      const err = new Error("الرد ليس بصيغة JSON صالحة");
      err.code = EXIT.PROTOCOL;
      throw err;
    }
    return { data, ms };
  } catch (e) {
    if (e.code === EXIT.PROTOCOL) throw e;
    const err = new Error(e.name === "AbortError" ? `انتهت المهلة بعد ${opts.timeout}ms` : e.message);
    err.code = EXIT.NETWORK;
    throw err;
  } finally {
    clearTimeout(timer);
  }
}

