`;

async function cmdDoctor(opts, loadedFiles) {
  const checks = [];
  const add = (category, name, ok, detail, fixable = null) =>
    checks.push({ category, name, ok, detail, fixable });

  const major = Number(process.versions.node.split(".")[0]);
  add("runtime", "Node.js >= 18", major >= 18, `node ${process.versions.node}`);
  add("runtime", "fetch API", typeof fetch === "function", typeof fetch === "function" ? "متوفّر" : "غير متوفّر");
  add("runtime", "المنصّة", os.platform() === "linux", `${os.platform()} ${os.arch()}`);
  const cfgDir = path.dirname(USER_ENV);
  const cfgOk = checkWritable(cfgDir);
  add("config", "مجلد الإعداد قابل للكتابة", cfgOk, cfgDir, cfgOk ? null : "mkdir");
  const userEnvOk = fs.existsSync(USER_ENV);
  add("config", "ملف إعداد المستخدم", userEnvOk, USER_ENV, userEnvOk ? null : "userenv");
  for (const f of CONFIG_FILES) {
    if (f === USER_ENV) continue;
    add("config", `ملف ${f}`, true, fs.existsSync(f) ? (loadedFiles.includes(f) ? "مُحمّل" : "موجود") : "غير موجود (اختياري)");
  }

  add("env", "IDAROOM_URL صالح", /^https?:\/\//.test(opts.url), opts.url);
  add("env", "IDAROOM_TIMEOUT صالح", opts.timeout >= 1000, `${opts.timeout} ms`);
  add("env", "مستوى السجلات صالح", !!LEVELS[opts.level], opts.level);

  const inPath = (() => {
    try {
      execFileSync("which", ["idaroom"], { stdio: "ignore" });
      return true;
    } catch {
      return false;
    }
  })();
  add("install", "الأمر idaroom في PATH", inPath, inPath ? "نعم" : "غير مثبّت عالمياً", inPath ? null : "symlink");

  let serverOk = false;
  try {
    const { data, ms } = await api(opts);
    serverOk = !!data.healthy;
    add("server", "الاتصال بالخادم", true, `${ms} ms`);
    add("server", "الويب", !!data.services?.web, data.services?.web ? "OK" : "FAIL");
    add("server", "الخلفية", !!data.services?.backend, data.services?.backend ? "OK" : "FAIL");
    add("server", "الإصدار", true, `v${data.version}`);
  } catch (e) {
    add("server", "الاتصال بالخادم", false, e.message);
  }

  const fixes = [];
  if (opts.fix) {
    for (const c of checks.filter((x) => !x.ok && x.fixable)) {
      if (opts.dryRun) {
        fixes.push({ item: c.name, action: c.fixable, applied: false, dryRun: true });
        continue;
      }
      try {
        if (c.fixable === "mkdir") fs.mkdirSync(cfgDir, { recursive: true, mode: 0o700 });
        if (c.fixable === "userenv") {
          fs.mkdirSync(cfgDir, { recursive: true, mode: 0o700 });
          fs.writeFileSync(USER_ENV, ENV_TEMPLATE, { mode: 0o600 });
        }
        if (c.fixable === "symlink") {
          if (process.getuid && process.getuid() !== 0) {
            fixes.push({ item: c.name, action: c.fixable, applied: false, needsRoot: true });
            continue;
          }
          fs.mkdirSync("/usr/local/bin", { recursive: true });
          fs.copyFileSync(process.argv[1], "/usr/local/bin/idaroom");
          fs.chmodSync("/usr/local/bin/idaroom", 0o755);
        }
        fixes.push({ item: c.name, action: c.fixable, applied: true });
        c.ok = true;
      } catch (e) {
        fixes.push({ item: c.name, action: c.fixable, applied: false, error: e.message });
      }
    }
  }

  const failed = checks.filter((c) => !c.ok);
  const needsRoot = fixes.some((f) => f.needsRoot);
  const fixFailed = fixes.some((f) => !f.applied && !f.dryRun && !f.needsRoot);

  emit(
    {
      summary: { total: checks.length, passed: checks.length - failed.length, failed: failed.length, serverHealthy: serverOk },
      checks,
      fixes,
    },
    [
      `فحص IDAROOM — ${checks.length - failed.length}/${checks.length} ناجح`,
      ...checks.map((c) => `  ${c.ok ? "✔" : "✖"} [${c.category}] ${c.name} — ${c.detail}`),
      ...(fixes.length
        ? ["الإصلاحات:", ...fixes.map((f) => `  ${f.applied ? "✔" : f.dryRun ? "…" : "✖"} ${f.item} (${f.action})${f.needsRoot ? " — يحتاج sudo" : ""}${f.error ? " — " + f.error : ""}`)]
        : failed.length
          ? ["نصيحة: نفّذ idaroom doctor --fix للإصلاح التلقائي."]
          : []),
    ],
    opts,
  );

  if (fixFailed) return EXIT.FIXFAILED;
  if (needsRoot) return EXIT.NEEDROOT;
  return failed.length ? EXIT.UNHEALTHY : EXIT.OK;
}

/* ------------------------------------------------------------------- shell */

const SHELL_COMMANDS = [
  "help", "status", "health", "ping", "version", "changelog", "routes", "config",
  "doctor", "open", "browser", "dashboard", "console", "watch", "demo",
  "set", "get", "clear", "exit", "quit",
];

const SHELL_HELP = `الوضع التفاعلي — اكتب الأوامر مباشرة بدون كلمة idaroom.

  status | health | ping | version | changelog [n] | routes | config
  doctor [--fix] [--dry-run]      فحص وإصلاح البيئة
  open /dashboard/students        فتح صفحة في المتصفح
  watch --every 30                مراقبة مستمرة (Ctrl+C للعودة)
  demo list | demo create <email> --role teacher | demo password <email> --password ...
  demo disable/enable <email> | demo link <email> --class "..." --card 04A1B2C3

أوامر الجلسة:
  set url <url>        تغيير عنوان الخادم للجلسة
  set timeout <ms>     تغيير المهلة
  set log <level>      silent|error|warn|info|debug|trace
  set json on|off      تبديل إخراج JSON
  set admin <email>    بريد المسؤول لأوامر demo
  set admin-password <pw>  كلمة مرور المسؤول (تبقى في الذاكرة فقط)
  get                  عرض إعدادات الجلسة
  clear                مسح الشاشة
  exit | quit | Ctrl+D الخروج

الموجه يعرض حالة الخادم مباشرة: ● سليم · ● خلل · ● لا اتصال، مع زمن الاستجابة
ورمز خروج آخر أمر.`;

async function probe(opts) {
  try {
    const { data, ms } = await api(opts);
    return { state: data.healthy ? "ok" : "bad", ms, version: data.version };
  } catch {
    return { state: "down", ms: null, version: null };
  }
}

function shellPrompt(opts, st, lastCode) {
  const c = (code, s) => (opts.color ? `\x1b[${code}m${s}\x1b[0m` : s);
  const dot = st.state === "ok" ? c(32, "●") : st.state === "bad" ? c(33, "●") : c(31, "●");
  const label = st.state === "ok" ? "سليم" : st.state === "bad" ? "خلل" : "لا اتصال";
  const lat = st.ms == null ? "—" : `${st.ms}ms`;
  const host = opts.url.replace(/^https?:\/\//, "");
  const exit = lastCode === 0 ? c(90, "0") : c(31, String(lastCode));
  return `${dot} ${c(90, label)} ${c(90, host)} ${c(90, lat)} ${c(90, "[" + exit + "]")} ${c(36, "idaroom")}${c(90, ">")} `;
}

async function cmdShell(opts, loadedFiles) {
  if (!process.stdin.isTTY) {
    log.error("shell", "الوضع التفاعلي يحتاج طرفية (TTY).");
    return EXIT.USAGE;
  }
  const readline = require("readline");
  let st = await probe(opts);
  let lastCode = EXIT.OK;

  out(`IDAROOM CLI v${CLI_VERSION} — الوضع التفاعلي. اكتب help للأوامر و exit للخروج.`);
  out(`الخادم: ${opts.url}${st.version ? ` · إصدار ${st.version}` : ""}`);

  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
    prompt: shellPrompt(opts, st, lastCode),
    historySize: 200,
    completer: (line) => {
      const hits = SHELL_COMMANDS.filter((c) => c.startsWith(line.trim()));
      return [hits.length ? hits : SHELL_COMMANDS, line];
    },
  });

  const refresh = async () => {
    st = await probe(opts);
    rl.setPrompt(shellPrompt(opts, st, lastCode));
  };
  const timer = setInterval(() => {
    void refresh();
  }, 30000);
  timer.unref?.();

  rl.prompt();

  await new Promise((resolve) => {
    let queue = Promise.resolve();
    rl.on("line", (line) => {
      queue = queue.then(() => handleLine(line));
    });
    async function handleLine(line) {
      const input = line.trim();
      if (input) {
        const parsed = parseArgs(input.split(/\s+/));
        const local = { ...opts, ...parsed.opts };
        // keep session defaults unless the line overrode them explicitly
        local.url = /--url/.test(input) ? parsed.opts.url : opts.url;
        local.timeout = /--timeout/.test(input) ? parsed.opts.timeout : opts.timeout;
        local.json = /--json/.test(input) ? true : opts.json;
        local.level = /--log-level|-V|--verbose|-vv|-q|--quiet/.test(input) ? parsed.opts.level : opts.level;
        log.level = local.level;
        log.json = local.json;
        log.color = local.color = opts.color;
        local.adminEmail = parsed.opts.adminEmail || opts.adminEmail;
        local.adminPassword = parsed.opts.adminPassword || opts.adminPassword;

        const cmd = (parsed.rest.shift() || "").toLowerCase();
        const rest = parsed.rest;
        try {
          if (cmd === "exit" || cmd === "quit") {
            rl.close();
            return;
          } else if (cmd === "help" || cmd === "?") {
            out(SHELL_HELP);
            lastCode = EXIT.OK;
          } else if (cmd === "clear") {
            process.stdout.write("\x1b[2J\x1b[H");
            lastCode = EXIT.OK;
          } else if (cmd === "get") {
            lastCode = cmdConfig(opts, loadedFiles);
          } else if (cmd === "set") {
            lastCode = shellSet(opts, rest);
          } else {
            lastCode = (await dispatch(cmd, rest, local, loadedFiles)) ?? EXIT.OK;
          }
        } catch (e) {
          log.error("shell", e.message);
          out(`خطأ: ${e.message}`);
          lastCode = e.code || EXIT.INTERNAL;
        }
        await refresh();
      }
      rl.setPrompt(shellPrompt(opts, st, lastCode));
      rl.prompt();
    }
    rl.on("close", () => {
      clearInterval(timer);
      void queue.then(() => {
        out("إلى اللقاء.");
        resolve();
      });
    });
  });

  return lastCode;
}

function shellSet(opts, rest) {
  const [key, ...vals] = rest;
  const value = vals.join(" ");
  switch ((key || "").toLowerCase()) {
    case "url":
      if (!value) return out("استعمال: set url https://example.com"), EXIT.USAGE;
      opts.url = value.replace(/\/+$/, "");
      out(`الخادم: ${opts.url}`);
      return EXIT.OK;
    case "timeout": {
      const n = Number(value);
      if (!Number.isFinite(n) || n <= 0) return out("استعمال: set timeout 5000"), EXIT.USAGE;
      opts.timeout = n;
      out(`المهلة: ${opts.timeout}ms`);
      return EXIT.OK;
    }
    case "log":
    case "log-level":
      if (!LEVELS[value]) return out("القيم: silent|error|warn|info|debug|trace"), EXIT.USAGE;
      opts.level = value;
      log.level = value;
      out(`مستوى السجل: ${value}`);
      return EXIT.OK;
    case "json":
      opts.json = value !== "off" && value !== "false";
      log.json = opts.json;
      out(`JSON: ${opts.json ? "on" : "off"}`);
      return EXIT.OK;
    case "admin":
    case "admin-email":
      if (!value) return out("استعمال: set admin admin@demo.idarroom.dz"), EXIT.USAGE;
      opts.adminEmail = value;
      out(`مسؤول demo: ${opts.adminEmail}`);
      return EXIT.OK;
    case "admin-password":
      if (!value) return out("استعمال: set admin-password <pw>"), EXIT.USAGE;
      opts.adminPassword = value;
      out("تم ضبط كلمة مرور المسؤول للجلسة.");
      return EXIT.OK;
    case "color":
      opts.color = value !== "off" && value !== "false";
      log.color = opts.color;
      out(`الألوان: ${opts.color ? "on" : "off"}`);
      return EXIT.OK;
    default:
      out("المفاتيح: url | timeout | log | json | color | admin | admin-password");
      return EXIT.USAGE;
  }
}

/* -------------------------------------------------------------------- main */

async function dispatch(cmd, rest, opts, loadedFiles) {
  switch (cmd) {
    case "help":
    case "-h":
    case "--help":
      out(HELP);
      return EXIT.OK;
    case "version":
    case "-v":
    case "--version":
      return cmdVersion(opts);
    case "status":
    case "info":
      return cmdStatus(opts);
    case "health":
      return cmdHealth(opts);
    case "ping":
      return cmdPing(opts);
    case "changelog":
      return cmdChangelog(opts, rest);
    case "routes":
      return cmdRoutes(opts);
    case "config":
      return cmdConfig(opts, loadedFiles);
    case "doctor":
      return cmdDoctor(opts, loadedFiles);
    case "open":
    case "browser":
      return cmdOpen(opts, rest);
    case "dashboard":
      return cmdOpen(opts, ["/dashboard"]);
    case "console":
      return cmdOpen(opts, ["/dashboard/console"]);
    case "watch":
      return cmdWatch(opts, rest);
    case "demo":
    case "accounts":
      return cmdDemo(opts, rest);
    default:
      log.error("cli", `أمر غير معروف: ${cmd}`);
      out(`أمر غير معروف: ${cmd} — جرّب: help`);
      return EXIT.USAGE;
  }
}

async function main() {
  const loadedFiles = loadEnvFiles();
  const { opts, rest } = parseArgs(process.argv.slice(2));
  const cmd = (rest.shift() || process.env.IDAROOM_COMMAND || "help").toLowerCase();
  log.debug("cli", `command=${cmd} url=${opts.url}`);

  if (cmd === "shell" || cmd === "repl" || cmd === "interactive" || cmd === "-i" || cmd === "--interactive") {
    return cmdShell(opts, loadedFiles);
  }
  return dispatch(cmd, rest, opts, loadedFiles);
}

main()
  .then((code) => process.exit(code ?? EXIT.OK))
  .catch((e) => {
    log.error("cli", e.message);
    if (process.env.IDAROOM_JSON) out(JSON.stringify({ error: e.message }));
    else out(`خطأ: ${e.message}`);
    process.exit(e.code || EXIT.INTERNAL);
  });

