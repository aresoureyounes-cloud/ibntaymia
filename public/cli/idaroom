async function cmdStatus(opts) {
  const { data, ms } = await api(opts);
  emit({ ...data, latencyMs: ms, cli: CLI_VERSION }, [
    `IDAROOM v${data.version} (${data.releaseDate || "—"})`,
    `الخادم:   ${data.origin}`,
    `الويب:    ${data.services?.web ? "OK" : "FAIL"}`,
    `الخلفية:  ${data.services?.backend ? "OK" : "FAIL"}`,
    `الحالة:   ${data.healthy ? "سليم" : "يوجد خلل"}`,
    `الاستجابة: ${ms} ms`,
    `CLI:      v${CLI_VERSION} (node ${process.versions.node})`,
  ], opts);
  return data.healthy ? EXIT.OK : EXIT.UNHEALTHY;
}

async function cmdHealth(opts) {
  const { data, ms } = await api(opts);
  emit({ healthy: !!data.healthy, services: data.services, latencyMs: ms }, [
    `web=${data.services?.web ? "ok" : "fail"} backend=${data.services?.backend ? "ok" : "fail"} ${ms}ms`,
    data.healthy ? "سليم" : "يوجد خلل",
  ], opts);
  return data.healthy ? EXIT.OK : EXIT.UNHEALTHY;
}

async function cmdPing(opts) {
  const { ms } = await api(opts);
  emit({ latencyMs: ms, url: opts.url }, [`${ms} ms — ${opts.url}`], opts);
  return EXIT.OK;
}

async function cmdVersion(opts) {
  let server = null;
  try {
    server = (await api(opts)).data;
  } catch (e) {
    log.warn("version", `تعذّر جلب إصدار الخادم: ${e.message}`);
  }
  emit({ cli: CLI_VERSION, node: process.versions.node, server: server?.version ?? null }, [
    `idaroom-cli v${CLI_VERSION} (node ${process.versions.node})`,
    `الخادم: ${server ? "v" + server.version : "غير متاح"}`,
  ], opts);
  return EXIT.OK;
}

async function cmdChangelog(opts, rest) {
  const n = Math.max(1, parseInt(rest[0] ?? "3", 10) || 3);
  const { data } = await api(opts);
  const notes = (data.notes || []).slice(0, n);
  emit({ version: data.version, notes }, [`v${data.version} — ${data.releaseDate || ""}`, ...notes.map((x) => `  • ${x}`)], opts);
  return EXIT.OK;
}

