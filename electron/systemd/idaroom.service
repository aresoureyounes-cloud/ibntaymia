[Unit]
Description=IDAROOM Desktop (واجهة التطبيق)
Documentation=man:idaroom(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# الإعدادات: النظام ثم المستخدم. علامة "-" تعني تجاهل الملف الناقص.
EnvironmentFile=-/etc/idaroom/idaroom.env
EnvironmentFile=-%h/.config/idaroom/idaroom.env
Environment=IDAROOM_NO_COLOR=1
# غيّر الأمر/الصفحة عبر متغيّرات البيئة بدل تعديل هذا الملف:
#   systemctl --user edit idaroom.service  →  Environment=IDAROOM_COMMAND=dashboard
ExecStart=/usr/bin/idaroom
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# رمز 3 = خطأ استعمال، لا فائدة من إعادة المحاولة
RestartPreventExitStatus=3
SyslogIdentifier=idaroom

[Install]
WantedBy=graphical-session.target
