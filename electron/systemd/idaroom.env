# IDAROOM — إعدادات سطر الأوامر والخدمة
# ينسخ إلى /etc/idaroom/idaroom.env (عام) أو ~/.config/idaroom/idaroom.env (للمستخدم)
# أي متغيّر مُصدَّر في البيئة الحقيقية له الأولوية على هذا الملف.

# عنوان الخادم
IDAROOM_URL=https://idara25.lovable.app

# مستوى السجلات: silent|error|warn|info|debug|trace
IDAROOM_LOG_LEVEL=info

# تفصيل إضافي (1 = debug، 2 = trace) — بديل عن -V/-vv
#IDAROOM_VERBOSE=1

# كتم المخرجات (يعادل --quiet)
#IDAROOM_QUIET=1

# إخراج JSON دائماً (مناسب لـ journald والسكربتات)
#IDAROOM_JSON=1

# تعطيل ألوان ANSI (موصى به داخل systemd)
IDAROOM_NO_COLOR=1

# مهلة الاتصال بالمللي ثانية
IDAROOM_TIMEOUT=10000

# الأمر والصفحة الافتراضية عند التشغيل بلا وسائط
#IDAROOM_COMMAND=dashboard
#IDAROOM_PAGE=/dashboard
#IDAROOM_KIOSK=1
#IDAROOM_FULLSCREEN=1
